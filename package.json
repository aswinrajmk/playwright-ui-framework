{
  "name": "playwright-ui-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + TypeScript test automation framework",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --config suites/smoke.config.ts",
    "test:regression": "npx playwright test --config suites/regression.config.ts",
    "test:ui": "npx playwright test --project=chromium",
    "test:api": "npx playwright test --project=api",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:dev": "cross-env ENV=dev npx playwright test",
    "test:staging": "cross-env ENV=staging npx playwright test",
    "test:prod": "cross-env ENV=prod npx playwright test",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:parallel": "npx playwright test --workers=4",
    "report": "npx playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npx playwright test tests/api && npm run allure:generate && npm run allure:open",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "clean": "rm -rf test-results allure-results allure-report playwright-report"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.0",
    "typescript": "^5.7.0",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=18"
  }
}
